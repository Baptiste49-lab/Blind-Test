<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- En-tête : Titre, e-mail et bouton de déconnexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="BLIND TEST"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Connecté"
                    android:textColor="#8B949E"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Quitter"
                android:textAllCaps="false"
                android:textColor="#F85149"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="#F85149" />
        </LinearLayout>

        <!-- Carte 1 : Thème (Par Genre ou Par Artiste / Musique) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="THÈME DE LA PARTIE"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSearchType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbByGenre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#58A6FF"
                        android:checked="true"
                        android:text="Par Genre"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rbByArtist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#58A6FF"
                        android:text="Artiste / Thème"
                        android:textColor="#FFFFFF" />
                </RadioGroup>

                <!-- Sélection du genre -->
                <Spinner
                    android:id="@+id/spinnerGenre"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#58A6FF"
                    android:popupBackground="#161B22" />

                <!-- Saisie avec autocomplétion Deezer obligatoire -->
                <AutoCompleteTextView
                    android:id="@+id/etArtistSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#0D1117"
                    android:completionThreshold="2"
                    android:dropDownVerticalOffset="4dp"
                    android:hint="Tapez un artiste ou un titre..."
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:popupBackground="#161B22"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8B949E"
                    android:visibility="gone" />

                <!-- Statut de validation (orange tant que non cliqué, vert une fois cliqué) -->
                <TextView
                    android:id="@+id/tvValidationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sélectionnez une proposition dans la liste"
                    android:textColor="#FF9800"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 2 : Ce qu'il faut deviner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="DEVINER"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgGuessType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbGuessTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#58A6FF"
                        android:checked="true"
                        android:text="Nom du titre"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rbGuessArtist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#58A6FF"
                        android:text="Nom de l'artiste"
                        android:textColor="#FFFFFF" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 3 : Difficulté -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="DIFFICULTÉ"
                    android:textColor="#58A6FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgDifficulty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbFacile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#58A6FF"
                        android:checked="true"
                        android:text="Facile — 30s + Pochettes (QCM)"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rbMoyen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#58A6FF"
                        android:text="Moyen — 15s sans pochette (QCM)"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/rbDifficile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="#58A6FF"
                        android:text="Difficile — Flash 5s (Texte / Voix)"
                        android:textColor="#FFFFFF" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 4 : Nombre de pistes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#30363D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NOMBRE DE PISTES"
                        android:textColor="#58A6FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrackCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 pistes"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15"
                    android:progress="5"
                    android:progressTint="#58A6FF"
                    android:thumbTint="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton Lancer la partie -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#1F6FEB"
            android:text="Lancer la partie"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <!-- Bouton Classement -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaderboard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="Classement Top 10"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="#30363D" />

    </LinearLayout>
</ScrollView>